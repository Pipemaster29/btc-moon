NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só para GRAVAR no arquivo (npm run arquivar). É a chave de serviço: ela ignora
# RLS e nunca deve ir para o navegador — no GitHub Actions ela vive em Secrets.
# Sem ela o projeto roda inteiro; o que não acontece é o arquivo crescer.
SUPABASE_SERVICE_ROLE_KEY=

# Alertas do radar pelo Telegram (veja o README para como obter os dois)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
